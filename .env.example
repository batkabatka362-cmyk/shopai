# ShopAI Environment Configuration
# Copy to .env and fill in your values.
# See docs/T1_GO_LIVE.md for the step-by-step go-live walkthrough.

# Environment: development | staging | production
SHOPAI_ENV=development


# ════════════════════════════════════════════════════════════
# T1 PREREQUISITES (required for live deploy)
# ════════════════════════════════════════════════════════════

# ── 1. Shopify store ────────────────────────────────────────
# Get from partners.shopify.com → Stores → Add store →
# Development store. Domain ends in .myshopify.com.
SHOPAI_SHOPIFY_URL=your-store.myshopify.com

# Admin API token from store admin → Settings → Apps and
# sales channels → Develop apps → Create an app → Configure
# scopes → Install → Reveal token. Starts with shpat_ or shppa_.
SHOPAI_SHOPIFY_KEY=shpat_xxxxxxxxxxxxxxxxxxxx

# OAuth alternative (2026+) — leave SHOPAI_SHOPIFY_KEY blank
# and supply Client ID + Secret from a Custom App.
# SHOPAI_SHOPIFY_CLIENT_ID=
# SHOPAI_SHOPIFY_CLIENT_SECRET=


# ── 2. Webhook callback URL ─────────────────────────────────
# Public https URL Shopify can POST to. Without it,
# OrderWebhookHandler never fires → learning loop stays dark.
#
# Easy options:
#   ngrok http 8080           → https://abc123.ngrok-free.app
#   cloudflared tunnel run    → https://random.trycloudflare.com
#   fly.io / railway deploy   → https://your-app.fly.dev
#
# The /api/webhook/shopify suffix is required.
SHOPAI_WEBHOOK_CALLBACK_URL=https://your-tunnel.example.com/api/webhook/shopify

# Random 32+ char string. ShopAI verifies HMAC of incoming
# webhooks using this. Don't reuse another secret.
SHOPAI_WEBHOOK_SECRET=change_me_to_a_random_32_char_string


# ── 3. Live execution gate ──────────────────────────────────
# §4b/G paranoid mode — keep OFF until `shopai ready-for-live`
# returns READY. When OFF every Shopify/Meta write is dry-run.
SHOPAI_ENABLE_LIVE_EXECUTION=0


# ── 4. API bearer token (SSRF / unauth-write defence) ───────
# Every POST write endpoint on api/server.py (/api/launch,
# /api/task, /api/workflow, /api/auto/cycle, /api/store/sync,
# /api/agent, /api/batch, /api/analyze, /api/chain) requires
# `Authorization: Bearer <token>`. The /api/webhook/shopify
# endpoint is HMAC-authed separately.
#
# Leave BLANK to auto-generate a random token on each process
# start (good for dev; bad for production — restart loses
# clients). Set a stable value (32+ random chars) for prod.
SHOPAI_API_TOKEN=change_me_random_32_char_hex_string


# ════════════════════════════════════════════════════════════
# AI MODEL CHAIN (CLAUDE.md §5 — 3-agent architecture)
# ════════════════════════════════════════════════════════════

# Model 1 — Automation. Free 30 req/min. groq.com → API keys.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Model 2 — Data / memory + multimodal.
# console.cloud.google.com → Generative AI → API keys.
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx

# Model 3 — Deep reasoning. platform.deepseek.com → API keys.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Optional fallback chain (used only when models 1-3 all fail)
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_TOKEN=

# Local Ollama fallback (math algorithms work offline if no
# remote model is reachable). docker-compose: http://ollama:11434.
SHOPAI_OLLAMA_URL=http://localhost:11434
# SHOPAI_OLLAMA_MODELS=mistral qwen2.5 llama3.2

# CLAUDE.md §5 explicitly excludes OPENAI / ANTHROPIC from the
# default chain — the 3 above + Ollama cover every use case
# at lower cost. Uncomment ONLY if you have specific reason.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=


# ════════════════════════════════════════════════════════════
# META ADS (optional — first T1 test can skip)
# ════════════════════════════════════════════════════════════
# Get from developers.facebook.com → Create App → "Other" →
# "Business" → add Marketing API product. Sandbox ad account
# at business.facebook.com → Business Settings → Ad Accounts.

# META_ADS_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx
# META_ADS_ACCOUNT_ID=act_1234567890
# META_ADS_PIXEL_ID=1234567890
# META_ADS_PAGE_ID=123456789012345


# ════════════════════════════════════════════════════════════
# OPTIONAL — TRACKING PIXELS (auto-installed via store_configurator)
# ════════════════════════════════════════════════════════════
# Full https URL of each pixel script. The store_configurator's
# `script_tags` feature reads these env vars and installs each
# present URL on the storefront. Non-https URLs are rejected.

# SHOPAI_META_PIXEL_SRC=https://connect.facebook.net/en_US/fbevents.js
# SHOPAI_TIKTOK_PIXEL_SRC=https://analytics.tiktok.com/i18n/pixel/events.js
# SHOPAI_GA_SRC=https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX


# ════════════════════════════════════════════════════════════
# OPTIONAL — DROPSHIPPING SUPPLIER
# ════════════════════════════════════════════════════════════
# CJ Dropshipping is the supported supplier today; AutoDS is
# on the roadmap (PATH_TO_T2.md).

# CJ_DROPSHIPPING_API_KEY=cj_xxxxxxxxxxxxxxxxxxxx
# AUTODS_API_KEY=                  # roadmap

# Enable order auto-dispatch to CJ on each paid Shopify order.
# Off by default — analytics-only owners stay safe.
# SHOPAI_ENABLE_CJ_FULFILL=0


# ════════════════════════════════════════════════════════════
# OPTIONAL — KNOWLEDGE / VAULT
# ════════════════════════════════════════════════════════════
# Obsidian vault for memory ↔ vault sync. Path on local disk.
# OBSIDIAN_VAULT_PATH=./vault


# ════════════════════════════════════════════════════════════
# OPTIONAL — TELEGRAM (owner notifications)
# ════════════════════════════════════════════════════════════
# Get from @BotFather. chat_id from your own user via @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=


# ════════════════════════════════════════════════════════════
# RUNTIME / SYSTEM
# ════════════════════════════════════════════════════════════
SHOPAI_API_HOST=0.0.0.0
SHOPAI_API_PORT=8080
SHOPAI_LOG_LEVEL=INFO

# Cycle interval seconds (autopilot daemon)
# SHOPAI_SYNC_INTERVAL=300

# DB path
# SHOPAI_DB_PATH=data/shopai.db

# llms.txt rebuild interval (cycles between rebuilds)
# SHOPAI_LLMS_TXT_REBUILD_EVERY=10

# Video pre-gen cache TTL (days)
# SHOPAI_VIDEO_CACHE_TTL_DAYS=30

# Opt-in: video generation (requires fal.ai key + cost control)
# SHOPAI_VIDEO_GENERATE=0
# FAL_KEY=
