# ShopAI Environment Configuration
# Copy to .env and fill in your values

# Environment: development | staging | production
SHOPAI_ENV=development

# ── Primary Shopify Store ────────────────────────────────
SHOPAI_SHOPIFY_URL=your-store.myshopify.com

# OAuth (2026+) — Client ID + Secret from Shopify Dev Dashboard
# Tokens auto-refresh every 24 hours
SHOPAI_SHOPIFY_CLIENT_ID=your_client_id_here
SHOPAI_SHOPIFY_CLIENT_SECRET=your_client_secret_here

# Legacy (pre-2026) — static API token (if you have one)
# SHOPAI_SHOPIFY_KEY=shpat_xxxxxxxxxxxxxxxxxxxx

# ── Additional Stores (multi-store mode) ─────────────────
# Add more stores with numbered suffixes:
# SHOPAI_STORE_2_URL=second-store.myshopify.com
# SHOPAI_STORE_2_KEY=shpat_xxxxxxxxxxxxxxxxxxxx
# SHOPAI_STORE_2_NAME=My Second Store
# SHOPAI_STORE_2_NICHE=electronics
# SHOPAI_STORE_2_TYPE=dropshipping

# ── AI Model Server ─────────────────────────────────────
SHOPAI_OLLAMA_URL=http://localhost:11434

# ── Database ─────────────────────────────────────────────
# SQLite database path (default: data/shopai.db)
# SHOPAI_DB_PATH=data/shopai.db

# ── Data Sync ────────────────────────────────────────────
# Auto-sync interval in seconds (default: 300 = 5 min)
# SHOPAI_SYNC_INTERVAL=300

# ── API Server ───────────────────────────────────────────
SHOPAI_API_HOST=0.0.0.0
SHOPAI_API_PORT=8080

# ── Logging ──────────────────────────────────────────────
SHOPAI_LOG_LEVEL=INFO
